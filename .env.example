# Copy to .env.local. Without DATABASE_URL, development uses isolated demo data.
DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
APP_URL=http://localhost:3000
# 32 random bytes as hex: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Only enable for a public demonstration, never for real household data.
DEMO_MODE=false
